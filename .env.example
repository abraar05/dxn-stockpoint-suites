# Mohammadpur Stock Point - server environment
# Copy to .env (or pass via docker --env-file / host env) and fill in real values.
# In production mode (NODE_ENV=production) the server refuses to start with
# the default PIN (2468) or default admin key — change both below.

NODE_ENV=production
PORT=4173
HOST=0.0.0.0

# Shop PIN for admin sign-in (change from default 2468!)
DXN_PIN=change-me-strong-pin

# Machine-to-machine admin key (change from default!)
DXN_ADMIN_KEY=change-me-long-random-string

# Optional: seed friendly demo sales on first boot
# DXN_DEMO=1